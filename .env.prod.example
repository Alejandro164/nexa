# Copiar a .env en el servidor (junto a docker-compose.prod.yml) y completar.
# Este archivo NUNCA debe contener valores reales — solo placeholders.

# Postgres nativo del servidor (instancia compartida, no contenerizado)
# El rol y la base deben existir de antemano en esa instancia.
POSTGRES_USER=nexa
POSTGRES_PASSWORD=
POSTGRES_DB=nexa_db

# Redis
REDIS_PASSWORD=

# Puerto publicado en el host para la app (nginx del servidor apunta aquí)
APP_PORT=8082
